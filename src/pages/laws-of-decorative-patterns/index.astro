---
import { getCollection } from 'astro:content';
import Container from '@/components/Container.astro';
import HeadingLevel1 from '@/components/HeadingLevel1.astro';
import { siteConfig } from '@/config';
import { lawsOfDecorativePatternsSection } from '@/data/laws-of-decorative-patterns-data';
import Layout from '@/layouts/Layout.astro';

// const { siteBase } = siteConfig;

const collections = await getCollection('lawsOfDecorativePatterns');
---

<Layout>
  <Container>
    <HeadingLevel1
      title="装飾パターンの法則"
      isCenter={true}
    />

    {lawsOfDecorativePatternsSection.map((item) => {
      const filterPages = collections.filter((page) => page.data.section === item.name);
      const sortPages = filterPages.sort((a, b) => a.data.order - b.data.order);
      return (
        <section>
          <h2>{item.name}</h2>
          <ul>
            {sortPages.map((page) => (
              <li>
                <a href={`/laws-of-decorative-patterns/${page.slug}`}>{page.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    })}
  </Container>
</Layout>
