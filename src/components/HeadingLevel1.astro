---
interface Props {
  title: string;
  isCenter?: boolean;
}

const { title, isCenter } = Astro.props;
---

<h1 class={isCenter ? "text-center" : ""}>{title}</h1>

<style lang="scss">
  h1 {
    font-size: 2rem;
    font-weight: 700;
    &.text-center {
      text-align: center;
    }
  }
</style>
